# Copy to .env and fill in your keys.
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Google Places API (New). Enable "Places API (New)" in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# Anthropic API key for pitch-email generation.
ANTHROPIC_API_KEY=

# Stripe — use test keys while developing.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public URL Stripe redirects back to. e.g. http://localhost:3000
APP_URL=http://localhost:3000

# Optional: skip Stripe entirely and grant every logged-in user a fake active sub.
# Useful for local development. Set to "true" to enable.
DEV_BYPASS_BILLING=false
